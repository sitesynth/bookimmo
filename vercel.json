{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/directus-bridge.js": {
      "includeFiles": "public/directus-bridge.js"
    },
    "api/asset.js": {
      "includeFiles": "_local/**"
    },
    "api/page.js": {
      "includeFiles": "{de,en,fr,it,nl}/index.html"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page?lang=de" },
    { "source": "/de", "destination": "/api/page?lang=de" },
    { "source": "/de/", "destination": "/api/page?lang=de" },
    { "source": "/de/index.html", "destination": "/api/page?lang=de" },
    { "source": "/en", "destination": "/api/page?lang=en" },
    { "source": "/en/", "destination": "/api/page?lang=en" },
    { "source": "/en/index.html", "destination": "/api/page?lang=en" },
    { "source": "/fr", "destination": "/api/page?lang=fr" },
    { "source": "/fr/", "destination": "/api/page?lang=fr" },
    { "source": "/fr/index.html", "destination": "/api/page?lang=fr" },
    { "source": "/it", "destination": "/api/page?lang=it" },
    { "source": "/it/", "destination": "/api/page?lang=it" },
    { "source": "/it/index.html", "destination": "/api/page?lang=it" },
    { "source": "/nl", "destination": "/api/page?lang=nl" },
    { "source": "/nl/", "destination": "/api/page?lang=nl" },
    { "source": "/nl/index.html", "destination": "/api/page?lang=nl" },
    { "source": "/_local/:path*", "destination": "/api/asset?path=_local/:path*" },
    { "source": "/favicon.ico", "destination": "/api/asset?path=_local/static/images/9s20P45oGrfvd6tA0odGVXuuo.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-eval' 'unsafe-inline' https: blob:; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:;"
        }
      ]
    }
  ]
}
