{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/directus-bridge.js": {
      "includeFiles": "public/directus-bridge.js"
    },
    "api/directus.js": {
      "includeFiles": "{}"
    }
  },
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/de/index.html" },
    { "source": "/de", "destination": "/de/index.html" },
    { "source": "/de/", "destination": "/de/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/", "destination": "/en/index.html" },
    { "source": "/fr", "destination": "/fr/index.html" },
    { "source": "/fr/", "destination": "/fr/index.html" },
    { "source": "/it", "destination": "/it/index.html" },
    { "source": "/it/", "destination": "/it/index.html" },
    { "source": "/nl", "destination": "/nl/index.html" },
    { "source": "/nl/", "destination": "/nl/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-eval' 'unsafe-inline' https: blob:; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:;"
        }
      ]
    }
  ]
}
